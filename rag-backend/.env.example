# 复制为 .env 后填入实际值：cp .env.example .env

# LLM API（阶段 4 必填，否则 /chat 无法生成）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 检索置信度：rerank 分低于此值走 fallback（默认 -5.0）
RETRIEVAL_CONFIDENCE_MIN=-5.0

# CORS（前端 Widget 跨域，逗号分隔；开发可用 *）
CORS_ORIGINS=*

# Embedding 模型（HuggingFace 模型 ID 或本地路径）
EMBEDDING_MODEL=BAAI/bge-m3

# HuggingFace 镜像（国内网络建议开启）
# HF_ENDPOINT=https://hf-mirror.com

# 若已通过 scripts/download_model.py 下载，可改为本地路径：
# EMBEDDING_MODEL=./data/models/Xorbits/bge-m3

# 博客数据源（相对于 rag-backend/）
POSTS_DIR=../_posts

# 分块参数
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Chroma 持久化目录（相对于 rag-backend/）
CHROMA_PERSIST_DIR=./data/chroma

# Chroma collection 名称
CHROMA_COLLECTION=blog_chunks

# 检索（阶段 3）
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=15
HYBRID_RRF_K=60
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# 服务配置
HOST=0.0.0.0
PORT=8000
DEBUG=true
