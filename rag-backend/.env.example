# 复制为 .env 后填入实际值：cp .env.example .env

# LLM API（阶段 4 使用，阶段 1 可留空）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Embedding 模型（HuggingFace 模型 ID 或本地路径）
EMBEDDING_MODEL=BAAI/bge-m3

# HuggingFace 镜像（国内网络建议开启）
# HF_ENDPOINT=https://hf-mirror.com

# 若已通过 scripts/download_model.py 下载，可改为本地路径：
# EMBEDDING_MODEL=./data/models/Xorbits/bge-m3

# 博客数据源（相对于 rag-backend/）
POSTS_DIR=../_posts

# 分块参数
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Chroma 持久化目录（相对于 rag-backend/）
CHROMA_PERSIST_DIR=./data/chroma

# Chroma collection 名称
CHROMA_COLLECTION=blog_chunks

# 服务配置
HOST=0.0.0.0
PORT=8000
DEBUG=true
